# Configure an OpenAI-compatible chat-completions endpoint without putting secrets in source.
ai.configure({
    "provider": "openai-compatible",
    "model": "your-model",
    "base_url": "http://localhost:8000/v1",
    "api_key_env": "PEALANG_AI_API_KEY",
    "timeout": 30
})
let response = ai.ask("Explain PeaLang in one sentence.")
print response.text
