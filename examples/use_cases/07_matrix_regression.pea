// Use case: matrix algebra and multiple regression
let x = [1, 2, 3, 4, 5]
let y = [2.1, 3.9, 6.2, 7.8, 10.1]
let fit = stats.linear_regression(x, y)
print "slope: " + str(round(fit["slope"], 3))
print "intercept: " + str(round(fit["intercept"], 3))
print "r2: " + str(round(fit["r_squared"], 4))

let features = [[1, 0], [0, 1], [1, 1], [2, 2], [3, 1]]
let target = [2, 3, 5, 9, 10]
let multi = stats.multiple_regression(features, target)
print "multi intercept: " + str(round(multi["intercept"], 3))
print "slopes: " + str(len(multi["slopes"]))
print "multi r2: " + str(round(multi["r_squared"], 4))

let a = [[3, 1], [1, 2]]
print "det: " + str(round(stats.determinant(a), 3))
let inv = stats.inverse(a)
print "inverse00: " + str(round(inv[0][0], 3))
let solved = stats.solve(a, [9, 8])
print "solved: " + str(round(solved[0], 3)) + ", " + str(round(solved[1], 3))
