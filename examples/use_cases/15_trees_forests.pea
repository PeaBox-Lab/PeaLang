// Use case: decision trees and random forests
// Regression: a nonlinear target that a linear model would miss
let rows = []
for i in range(0, 41) {
    let x = (i - 20) / 10.0
    let noise = ((i * 7) % 5 - 2) / 20.0
    let y = x * x + noise
    rows = rows + [{"x": x, "y": y}]
}

let tree = analysis.tree_report(rows, "y", ["x"], "regression", 4)
print "tree r2: " + str(round(tree["train_r2"], 3))
print "tree rmse: " + str(round(tree["train_rmse"], 3))

let forest = analysis.forest_report(rows, "y", ["x"], "regression", 25, 4, 2, 1, "all", true, 5)
print "forest r2: " + str(round(forest["train_r2"], 3))
print "forest rmse: " + str(round(forest["train_rmse"], 3))
print "forest oob r2: " + str(round(forest["oob_score"], 3))

// Classification: the label depends on a nonlinear region of two features
let crows = []
for i in range(0, 60) {
    let a = (i % 10) / 10.0 - 0.5
    let b = ((i * 7) % 11) / 11.0 - 0.5
    let label = 0
    if a * a + b * b > 0.18 {
        label = 1
    }
    crows = crows + [{"a": a, "b": b, "label": label}]
}

let forest_cls = analysis.forest_report(crows, "label", ["a", "b"], "auto", 25, 4, 2, 1, "sqrt", true, 5)
print "class accuracy: " + str(round(forest_cls["train_accuracy"], 3))
print "class oob: " + str(round(forest_cls["oob_score"], 3))
print "top feature: " + forest_cls["importance"][0]["feature"]

let tree_cls = analysis.tree_report(crows, "label", ["a", "b"], "classification", 4)
print "tree accuracy: " + str(round(tree_cls["train_accuracy"], 3))
print "tree top: " + tree_cls["importance"][0]["feature"]
let guess = stats.predict_tree(tree_cls, [[0.0, 0.0], [0.9, 0.9]])
print "tree guess: " + str(guess["predicted"])
