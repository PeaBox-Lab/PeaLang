// Use case: turn date strings into calendar features for modelling
let days = analysis.date_range("2023-01-01", "2024-06-30", "D", 1)
let rows = []
for k in range(0, len(days)) {
    let when = days[k]
    let region = "north"
    if k % 3 == 1 { region = "south" }
    if k % 3 == 2 { region = "east" }
    let part = stats.date_parts(days[k], ["month", "weekday"])
    let month = part["month"]
    let weekday = part["weekday"]
    let sales = 200.0 + month * 8.0 + (6 - weekday) * 4.0 + k * 0.15
    if k % 29 == 7 { when = null }
    rows = rows + [{"when": when, "region": region, "sales": sales}]
}

// A single date becomes a record of calendar parts
let parts = stats.date_parts("2024-03-09", ["year", "month", "weekday", "is_weekend", "epoch_day"])
print "parts: " + str(parts["year"]) + "-" + str(parts["month"]) + "-" + str(parts["weekday"]) + " weekend=" + str(parts["is_weekend"]) + " day=" + str(parts["epoch_day"])

// A vector of dates becomes a numeric matrix
let matrix = stats.calendar_features(["2024-01-05", "2024-02-10"], ["year", "month", "quarter", "month_sin"])
print "matrix: " + str(matrix["names"])

// Add calendar columns to existing records
let sample = [{"when": "2024-01-05", "sales": 10.0}, {"when": "2024-12-31", "sales": 20.0}]
let expanded = analysis.date_features(sample, "when", ["month", "weekday", "is_weekend"])
print "expanded: " + str(expanded[0]["when_month"]) + "/" + str(expanded[0]["when_weekday"]) + " weekend=" + str(expanded[0]["when_is_weekend"])

// Default model pipeline: impute, then expand dates, encode and scale
let model = analysis.model_pipeline(rows, "sales", ["when", "region"], null, "tree", "regression", {"max_depth": 6})
print "task: " + model["task"]
print "used: " + str(model["n_used"])
print "outputs: " + str(len(model["output_features"]))
print "calendar: " + str(model["output_features"][0]) + " .. " + str(model["output_features"][6])
print "r2: " + str(round(model["train_r2"], 3))
print "top: " + model["importance"][0]["feature"]

// Explicit parts add trend and seasonality encodings
let steps = [{"op": "impute", "method": "auto"}, {"op": "date", "parts": ["epoch_day", "month", "weekday", "is_weekend"]}, {"op": "encode", "method": "onehot"}, {"op": "scale", "method": "standard"}]
let tuned = analysis.model_pipeline(rows, "sales", ["when", "region"], steps, "tree", "regression", {"max_depth": 6})
print "tuned outputs: " + str(len(tuned["output_features"]))
print "tuned r2: " + str(round(tuned["train_r2"], 3))
print "tuned top: " + tuned["importance"][0]["feature"]

// Score a future date and a row with a missing date
let probes = [{"when": "2024-07-01", "region": "north"}, {"when": null, "region": "south"}]
print "probes: " + str([round(v, 2) for v in analysis.predict_pipeline(model, probes)["predicted"]])
