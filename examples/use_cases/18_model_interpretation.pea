// Use case: model interpretation with permutation importance and partial dependence
// Regression: explain a boosted model on a cubic target
let rows = []
for k in range(0, 25) {
    let x = (k - 12) / 4.0
    let noise = ((k * 7) % 5 - 2) / 20.0
    let y = x * x * x - x + noise
    rows = rows + [{"x": x, "noise": noise, "y": y}]
}

let reg = analysis.interpret_report(rows, "y", ["x", "noise"], "boosting", "regression", {"n_estimators": 30, "learning_rate": 0.2, "max_depth": 3}, 5, 7, 3, "r2", ["x"])
print "reg top: " + reg["permutation_importance"][0]["feature"]
print "reg score: " + str(round(reg["permutation_importance"][0]["mean"], 3))
print "reg baseline: " + str(round(reg["baseline"], 3))
print "reg curves: " + str(len(reg["partial_dependence"]))
let reg_curve = reg["partial_dependence"][0]
print "reg grid: " + str(len(reg_curve["values"]))
print "reg rise: " + str(reg_curve["average"][0] < reg_curve["average"][-1])

// Classification: separate signal from noise
let crows = []
for k in range(0, 60) {
    let signal = (k % 10) / 10.0
    let noise = ((k * 11) % 13) / 13.0
    let label = 0
    if signal > 0.5 {
        label = 1
    }
    crows = crows + [{"signal": signal, "noise": noise, "label": label}]
}

let cls = analysis.interpret_report(crows, "label", ["signal", "noise"], "forest", "auto", {"n_estimators": 20, "max_depth": 3}, 4, 5, 2, "accuracy", ["signal"])
print "cls task: " + cls["task"]
print "cls top: " + cls["permutation_importance"][0]["feature"]
print "cls score: " + str(round(cls["permutation_importance"][0]["mean"], 3))
print "cls noise: " + str(round(cls["permutation_importance"][1]["mean"], 3))
let cls_curve = cls["partial_dependence"][0]
print "cls classes: " + str(cls_curve["classes"])
print "cls low: " + str(round(cls_curve["average"][0], 3))
print "cls high: " + str(round(cls_curve["average"][-1], 3))

// The same helpers work on a model fitted elsewhere
let pi = stats.permutation_importance(cls, [[r["signal"], r["noise"]] for r in crows], [r["label"] for r in crows], "classification", 3, 9, "accuracy", ["signal", "noise"])
print "stats top: " + pi["importances"][0]["feature"]
let pd = stats.partial_dependence(cls, [[r["signal"], r["noise"]] for r in crows], ["signal"], 3, "classification", ["signal", "noise"])
print "stats curve: " + pd["curves"][0]["feature"]
