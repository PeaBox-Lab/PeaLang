

program          = { declaration } ;
declaration      = variable_decl | constant_decl | function_decl | import_decl | export_decl | statement ;
variable_decl    = "let", identifier, [ ":", type_ref ], [ "=", expression ] ;
constant_decl    = "const", identifier, [ ":", type_ref ], "=", expression ;
function_decl    = [ "async" ], "function", identifier, "(", [ parameters ], ")", [ "->", type_ref ], block ;
parameters       = parameter, { ",", parameter } ;
parameter        = identifier, [ ":", type_ref ], [ "=", expression ] ;
import_decl      = "import", string, [ "as", identifier ] ;
export_decl      = "export", identifier ;
statement        = if_stmt | while_stmt | for_stmt | return_stmt | try_stmt | throw_stmt | expression ;
block            = "{", { declaration }, "}" ;
if_stmt          = "if", expression, block, [ "else", block ] ;
while_stmt       = "while", expression, block ;
for_stmt         = "for", identifier, "in", expression, block ;
return_stmt      = "return", [ expression ] ;
try_stmt         = "try", block, [ "catch", identifier, block ], [ "finally", block ] ;
throw_stmt       = "throw", expression ;
type_ref         = identifier, [ "<", type_ref, { ",", type_ref }, ">" ], [ "?" ] ;
expression       = primary, { operator, primary } ;
primary          = identifier | number | string | "true" | "false" | "null" | list | map | "await", primary ;
identifier       = letter | "_", { letter | digit | "_" } ;


