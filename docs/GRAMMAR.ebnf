program = { separator | statement } , EOF ;
statement = declaration | printStmt | ifStmt | whileStmt | forStmt | functionStmt | returnStmt | breakStmt | continueStmt | importStmt | expression , [ assignmentOp , expression ] ;
declaration = ( "let" | "const" ) , IDENT , "=" , expression ;
printStmt = "print" , expression ;
ifStmt = "if" , expression , block , [ "else" , ( ifStmt | block ) ] ;
whileStmt = "while" , expression , block ;
forStmt = "for" , IDENT , "in" , expression , block ;
functionStmt = "function" , IDENT , "(" , [ IDENT , { "," , IDENT } ] , ")" , block ;
returnStmt = "return" , [ expression ] ;
breakStmt = "break" ; continueStmt = "continue" ;
importStmt = "import" , STRING ;
block = "{" , { separator | statement } , "}" ;
expression = orExpr ;
orExpr = andExpr , { "or" , andExpr } ;
andExpr = equality , { "and" , equality } ;
equality = comparison , { ( "==" | "!=" ) , comparison } ;
comparison = term , { ( "<" | "<=" | ">" | ">=" ) , term } ;
term = factor , { ( "+" | "-" ) , factor } ;
factor = unary , { ( "*" | "/" | "%" ) , unary } ;
unary = [ "-" | "not" ] , postfix ;
postfix = primary , { call | index | property } ;
call = "(" , [ expression , { "," , expression } ] , ")" ;
index = "[" , expression , "]" ; property = "." , IDENT ;
assignmentOp = "=" | "+=" | "-=" | "*=" | "/=" ;
separator = NEWLINE | ";" ;
